def get_model() -> str:
    if not AGENT_FILE.exists():
        return "Unknown"

    try:
        source = AGENT_FILE.read_text(encoding="utf-8")
        match = re.search(
            r'^MODEL\s*=\s*os\.getenv\(\s*["\']AGENTLAB_MODEL["\']\s*,\s*["\']([^"\']+)["\']',
            source,
            re.MULTILINE,
        )
        return os.getenv("AGENTLAB_MODEL", match.group(1) if match else "Unknown")
    except Exception:
        return "Unknown"


def get_ollama_status() -> tuple[bool, str]:
    try:
        result = subprocess.run(
            ["ollama", "list"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode != 0:
            return False, "Ollama unavailable"

        model = get_model()
        installed = any(
            line.split() and line.split()[0] == model
            for line in result.stdout.splitlines()[1:]
        )

        if installed:
            return True, f"{model} ready"

        return False, f"{model} not installed"
    except Exception:
        return False, "Ollama unavailable"


def get_reports() -> list[dict]:
    reports = []

    for path in sorted(
        RUNS.glob("run-*.json"),
        key=lambda item: item.stat().st_mtime,
        reverse=True,
    ):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            data["_path"] = str(path)
            data["_modified"] = path.stat().st_mtime
            reports.append(data)
        except Exception:
            continue

    return reports


def run_command(command: list[str], timeout: int = 120) -> tuple[int, str]:
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            capture_output=True,
            text=True,
            timeout=timeout,
            env={
                **os.environ,
                "PYTHONUNBUFFERED": "1",
            },
        )
        output = result.stdout

        if result.stderr:
            output += "\n--- STDERR ---\n" + result.stderr

        return result.returncode, output or "(No output)"
    except subprocess.TimeoutExpired as exc:
        output = "Command timed out."
        if exc.stdout:
            output += "\n" + str(exc.stdout)
        if exc.stderr:
            output += "\n" + str(exc.stderr)
        return 124, output
    except Exception as exc:
        return 1, f"{type(exc).__name__}: {exc}"


